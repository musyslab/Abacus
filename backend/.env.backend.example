# ---- Required ----
JWT_SECRET_KEY=replace-me

PASSWORD_TOKEN_SALT=replace-me
PASSWORD_TOKEN_MAX_AGE_SECONDS=86400

# Public URL of the React app. Used in emailed links and as the default CORS origin.
#   Prod:    https://abacus.cs.mu.edu
#   Staging: https://abacus-dev.cs.mu.edu
FRONTEND_BASE_URL=http://localhost:3000

# ---- Optional ----

# Comma-separated list of allowed CORS origins. Defaults to FRONTEND_BASE_URL.
#CORS_ORIGINS=http://localhost:3000,https://abacus-dev.cs.mu.edu

# Dev only. When true, new accounts are created with DEBUG_DEFAULT_PASSWORD
# instead of receiving a password-link email. DEBUG_DEFAULT_PASSWORD is
# required when DEBUGGER_MODE=true.
DEBUGGER_MODE=false
#DEBUG_DEFAULT_PASSWORD=

# ---- SMTP (used to send password links when DEBUGGER_MODE=false) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# ---- Database ----
# DB_USER / DB_PASSWORD / DB_HOST / DB_NAME / DB_PORT are set in docker-compose*.yaml
# under `environment:` (which overrides env_file). Set them here only when running
# the backend outside compose.
#DB_USER=
#DB_PASSWORD=
#DB_HOST=
#DB_NAME=
#DB_PORT=3306
